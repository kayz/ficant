# Strict GitHub release allowlist. Unknown root entries stay local.
/*

!/.gitignore
!/.dockerignore
!/.gitattributes
!/README.md
!/LICENSE
!/AGENTS.md
!/scripts/
!/scripts/**
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/rustfmt.toml
!/clippy.toml
!/cicd.yml
!/.config/
!/.config/**
!/.github/
!/.github/**
!/binaries/
!/binaries/**
!/crates/
!/crates/**
!/cpp/
!/cpp/**
!/deploy/
!/deploy/**
!/docs/
!/docs/**
!/domain-packs/
!/domain-packs/**
!/interface/
!/interface/**
!/python/
!/python/**
!/tests/
!/tests/**

# Local agent/IDE directories and temporary workspaces.
**/.[Qq][Oo][Dd][Ee][Rr]/
**/.[Cc][Oo][Dd][Ee][Xx]/
**/.[Cc][Ll][Aa][Uu][Dd][Ee]/
**/.[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee][Ss]/
**/[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee][Ss]/
**/[Tt][Ee][Mm][Pp]/
**/[Tt][Mm][Pp]/
**/[Cc][Aa][Cc][Hh][Ee]/
**/.[Cc][Aa][Cc][Hh][Ee]/

# Secrets and local configuration at every otherwise-published depth.
**/.env
**/.env.*
!**/.env.example
**/[Kk][Ee][Yy]/
**/[Kk][Ee][Yy][Ss]/
**/[Ss][Ee][Cc][Rr][Ee][Tt]/
**/[Ss][Ee][Cc][Rr][Ee][Tt][Ss]/
**/id_rsa
**/id_ed25519
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/*.keystore

# Build and tool caches.
**/target/
**/build/
**/.pytest_cache/
**/.venv/
**/__pycache__/
**/*.py[cod]
