{
  "name": "@ficant/contracts-generated",
  "version": "0.0.0",
  "private": true,
  "description": "Locally packaged TypeScript contracts generated from FICANT's authoritative protobuf interface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayz/ficant.git",
    "directory": "web-dm/packages/contracts-generated"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@bufbuild/protobuf": "2.5.2"
  },
  "engines": {
    "node": "22.17.0",
    "pnpm": "10.12.4"
  },
  "packageManager": "pnpm@10.12.4"
}
