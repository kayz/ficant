{
  "name": "@ficant/web-dm",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayz/ficant.git",
    "directory": "web-dm"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.17.0",
    "pnpm": "10.12.4"
  },
  "scripts": {
    "build": "pnpm --filter @ficant/platform-shell build",
    "contracts:package": "pwsh -NoProfile -NonInteractive -File ../scripts/package-contracts.ps1",
    "contracts:test-package": "pwsh -NoProfile -NonInteractive -File ../scripts/test-contract-package.ps1",
    "typecheck": "pnpm --filter @ficant/platform-shell typecheck",
    "test": "pnpm --filter @ficant/platform-shell test",
    "test:e2e": "playwright test",
    "test:e2e:grpc": "playwright test --config playwright.grpc.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
